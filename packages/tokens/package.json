{
  "name": "@codecora/tokens",
  "version": "0.7.0",
  "description": "Design tokens and themes for CodeCora products: one Tailwind 4 stylesheet on shadcn variable names, and the TypeScript token source",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecoradev/codecora-ui.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/css/theme.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/build-css.ts && publint",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "contrast": "bun scripts/contrast.ts"
  }
}
