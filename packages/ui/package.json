{
  "name": "@codecora/ui",
  "version": "0.0.0",
  "description": "Svelte 5 components for CodeCora products, on bits-ui and semantic --cc-* tokens",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecoradev/codecora-ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && publint",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.25.0"
  }
}
