{
  "name": "@codecora/memory",
  "version": "0.0.0",
  "description": "Uteke domain layer for CodeCora products: a MemoryClient with HTTP (uteke-serve, Uteke Cloud) and Tauri transports, and capabilities that say what a backend supports",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecoradev/codecora-ui.git",
    "directory": "packages/memory"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/contract.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && publint",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.33.0"
  }
}
