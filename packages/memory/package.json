{
  "name": "@codecora/memory",
  "version": "0.1.0",
  "description": "Uteke domain layer for CodeCora products: a MemoryClient with HTTP (uteke-serve, Uteke Cloud) and Tauri transports, capabilities that say what a backend supports, and the memory browser components",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecoradev/codecora-ui.git",
    "directory": "packages/memory"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/contract.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && publint",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@codecora/ui": "workspace:^",
    "svelte": "^5.33.0"
  },
  "devDependencies": {
    "@codecora/ui": "workspace:*"
  }
}
